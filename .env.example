# =============================================================================
# HEDGE-ExpertAI Environment Configuration
# Copy to .env and adjust as needed. Every default here matches
# docker-compose.yml and shared/hedge_shared/config.py.
# =============================================================================

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3.5:2b
# Enable only if supported and desired for the configured structured reasoning model.
OLLAMA_THINK=false
OLLAMA_TIMEOUT=180

# --- Vector DB (Qdrant) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- Durable PostgreSQL source of truth ---
POSTGRES_DB=hedge
POSTGRES_USER=hedge
POSTGRES_PASSWORD=hedge-dev-only
DATABASE_URL=postgresql://hedge:hedge-dev-only@postgres:5432/hedge

# --- Valkey operational state ---
VALKEY_SESSION_URL=redis://valkey-cache:6379/0
VALKEY_CACHE_URL=redis://valkey-cache:6379/1
VALKEY_RATE_LIMIT_URL=redis://valkey-cache:6379/2
VALKEY_QUEUE_URL=redis://valkey-queue:6379/0
# One-release compatibility alias.
REDIS_URL=redis://valkey-cache:6379/0

# --- Embedding ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
QDRANT_COLLECTION_VERSION=v2

# --- Feature flags ---
RASA_ENABLED=false
RERANKER_ENABLED=false
RASA_URL=http://rasa:5005
RASA_TIMEOUT=5
RASA_CONFIDENCE_THRESHOLD=0.60
RASA_SHADOW_MODE=false
RASA_CIRCUIT_OPEN_SECONDS=60

# --- App Store API ---
MOCK_API_URL=http://mock-api:9000
# Manual/read-only Store client configuration; scheduled Store ingestion stays disabled.
# Full HTTPS API base, e.g. https://store.haslab-dataspace.pt/backend/api/v1
# Empty retains scheduled synthetic ingestion; nonempty blocks that job without live calls.
HEDGE_API_URL=
HEDGE_STORE_ID=
# Absolute backend-only token-file path. Provision/rotate externally; never put tokens here.
# A container needs an explicit read-only mount; no token volume is enabled by this example.
HEDGE_STORE_TOKEN_FILE=
# Alternative backend M2M auth; do not also configure a Bearer token file.
HEDGE_STORE_ISSUER=
HEDGE_STORE_CLIENT_ID=
# Absolute owned mode-0600 secret file, never the secret itself.
HEDGE_STORE_CLIENT_SECRET_FILE=
HEDGE_STORE_TIMEOUT_SECONDS=30
HEDGE_STORE_MAX_RETRIES=2
# Explicit isolated private-service deployment only; never enable on the demo/public stack.
PRIVATE_STORE_ENABLED=false
# Private Store conversation settings; semantic recovery is opt-in.
# Opt-in contextual Rasa + LLM recovery for English Store turns.
# Point OLLAMA_BASE_URL at suitably provisioned private inference infrastructure.
STORE_SEMANTIC_ENABLED=false
STORE_MODEL_CONTEXT_TOKENS=16384
STORE_MODEL_OUTPUT_TOKENS=2048
STORE_MODEL_TIMEOUT_SECONDS=120
STORE_MODEL_THREADS=1
STORE_MODEL_BATCH_SIZE=128
STORE_MODEL_KEEP_ALIVE=2m
STORE_REASONING_ENABLED=false
STORE_REASONING_SECONDS=8
STORE_SYNC_INTERVAL_SECONDS=86400

# --- Ingestion ---
INGEST_INTERVAL_SECONDS=7200

# --- Service ports ---
# Bind the public gateway interface. Keep the default loopback value for local-only use.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080
CHAT_INTENT_PORT=8001
EXPERT_RECOMMEND_PORT=8002
DISCOVERY_RANKING_PORT=8003
METADATA_INGEST_PORT=8004
MOCK_API_PORT=9000

# --- General ---
LOG_LEVEL=INFO
APP_VERSION=0.2.0

# --- Security ---
# Administrative credential shared by gateway and metadata-ingest; provision securely.
# Empty disables ingestion/replay HTTP operations. Public discovery stays available.
GATEWAY_API_KEY=
# Comma-separated list of allowed CORS origins (default: * for development).
CORS_ALLOWED_ORIGINS=*
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128
ENABLE_HSTS=false
ENABLE_RBAC=false
RATE_LIMIT_REQUIRED=false
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# --- OAuth / OIDC ---
OAUTH_ENABLED=false
OAUTH_ISSUER=
OAUTH_AUDIENCE=hedge-expert-api
OAUTH_CLIENT_ID=hedge-expert-api
OAUTH_JWKS_URL=
# For local/testing only. Leave empty in production and use JWKS instead.
OAUTH_SHARED_SECRET=
OAUTH_JWT_ALGORITHMS=RS256
RBAC_ADMIN_ROLES=admin,administrator
RBAC_ANALYST_ROLES=analyst,admin

# --- TLS Edge ---
TLS_SERVER_NAME=localhost
TLS_SELF_SIGNED_DAYS=30
TLS_CERT_PATH=
TLS_KEY_PATH=

# --- Keycloak bootstrap ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_PORT=8081

# --- Service URLs (inter-service) ---
CHAT_INTENT_URL=http://chat-intent:8001
EXPERT_RECOMMEND_URL=http://expert-recommend:8002
DISCOVERY_RANKING_URL=http://discovery-ranking:8003
METADATA_INGEST_URL=http://metadata-ingest:8004
