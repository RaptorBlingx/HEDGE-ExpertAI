{
  "openapi": "3.1.0",
  "info": {
    "title": "HEDGE-ExpertAI Metadata Ingest",
    "version": "2.0.0"
  },
  "paths": {
    "/api/v2/ingestion/runs": {
      "post": {
        "summary": "Trigger Ingest",
        "description": "Queue a complete catalogue ingestion run.",
        "operationId": "trigger_ingest_api_v2_ingestion_runs_post",
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Trigger Ingest Api V2 Ingestion Runs Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ingest/trigger": {
      "post": {
        "summary": "Trigger Ingest",
        "description": "Queue a complete catalogue ingestion run.",
        "operationId": "trigger_ingest_api_v1_ingest_trigger_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Trigger Ingest Api V1 Ingest Trigger Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/ingestion/outbox/replay": {
      "post": {
        "summary": "Replay Outbox",
        "description": "Queue retry of failed or pending index operations.",
        "operationId": "replay_outbox_api_v2_ingestion_outbox_replay_post",
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Replay Outbox Api V2 Ingestion Outbox Replay Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/ingestion/runs/latest": {
      "get": {
        "summary": "Ingest Status",
        "description": "Return the latest durable ingestion run.",
        "operationId": "ingest_status_api_v2_ingestion_runs_latest_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Ingest Status Api V2 Ingestion Runs Latest Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ingest/status": {
      "get": {
        "summary": "Ingest Status",
        "description": "Return the latest durable ingestion run.",
        "operationId": "ingest_status_api_v1_ingest_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Ingest Status Api V1 Ingest Status Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/ingestion/runs/{run_id}": {
      "get": {
        "summary": "Ingestion Run",
        "description": "Return a specific durable run, not merely the most recent run.",
        "operationId": "ingestion_run_api_v2_ingestion_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Ingestion Run Api V2 Ingestion Runs  Run Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/ingestion/quarantine": {
      "get": {
        "summary": "Quarantine",
        "description": "Page validation errors without returning quarantined source payloads.",
        "operationId": "quarantine_api_v2_ingestion_quarantine_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Run Id"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Quarantine Api V2 Ingestion Quarantine Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/live": {
      "get": {
        "summary": "Live",
        "description": "Process liveness independent of dependencies.",
        "operationId": "live_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Ready",
        "description": "Dependency and first-run readiness.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Ready Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Compatibility alias for readiness.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
