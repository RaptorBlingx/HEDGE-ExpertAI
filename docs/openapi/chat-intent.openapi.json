  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "locale": {
            "type": "string",
            "pattern": "^(en|de|fr|es|it|nl|pt|tr)$",
            "title": "Locale",
            "default": "en"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatRequestV2": {
        "properties": {
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "de",
              "fr",
              "es",
              "it",
              "nl",
              "pt",
              "tr"
            ],
            "title": "Locale",
            "default": "en"
          },
          "filters": {
            "$ref": "#/components/schemas/SearchFilters"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequestV2",
        "description": "Versioned conversational search request."
      },
      "FeedbackRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "app_id": {
            "type": "string",
            "title": "App Id"
          },
          "action": {
            "type": "string",
            "pattern": "^(click|accept|dismiss)$",
            "title": "Action"
          },
          "rating": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "app_id",
          "action"
        ],
        "title": "FeedbackRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LifecycleStatus": {
        "type": "string",
        "enum": [
          "draft",
          "active",
          "deprecated",
          "retired"
        ],
        "title": "LifecycleStatus",
        "description": "Supported application lifecycle states."
      },
      "RecommendationEventRequest": {
        "properties": {
          "impression_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "title": "Impression Id"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "title": "Idempotency Key"
          },
          "event_type": {
            "$ref": "#/components/schemas/RecommendationEventType"
          },
          "app_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 3,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "App Id"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "impression_id",
          "idempotency_key",
          "event_type"
        ],
        "title": "RecommendationEventRequest",
        "description": "Verified and replay-safe recommendation event."
      },
      "RecommendationEventType": {
        "type": "string",
        "enum": [
          "recommendation_accepted",
          "recommendation_dismissed",
          "app_opened"
        ],
        "title": "RecommendationEventType",
        "description": "Allowed recommendation telemetry events."
      },
      "SearchFilters": {
        "properties": {
          "semantic_uri": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Semantic Uri"
          },
          "extension_uri": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extension Uri"
          },
          "publisher": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Publisher"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Capabilities"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Tags"
          },
          "protocols": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Protocols"
          },
          "deployment_modes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Deployment Modes"
          },
          "license_spdx": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "License Spdx"
          },
          "lifecycle_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LifecycleStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "supported_languages": {
            "items": {
              "type": "string",
              "enum": [
                "en",
                "de",
                "fr",
                "es",
                "it",
                "nl",
                "pt",
                "tr"
              ]
            },
            "type": "array",
            "title": "Supported Languages"
          },
          "data_classifications": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Data Classifications"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SearchFilters",
        "description": "Typed public catalogue filters."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
