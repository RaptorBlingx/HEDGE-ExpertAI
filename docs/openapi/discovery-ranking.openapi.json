      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Health check \u2014 verifies authoritative and derived stores.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/live": {
      "get": {
        "summary": "Live",
