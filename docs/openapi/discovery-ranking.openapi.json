  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IndexOperation": {
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "upsert",
              "delete"
            ],
            "title": "Operation"
          },
          "app_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "title": "App Id"
          },
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          },
          "app": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "App"
          }
        },
        "type": "object",
        "required": [
          "operation",
          "app_id",
          "revision"
        ],
        "title": "IndexOperation"
      },
      "IndexOperationsRequest": {
        "properties": {
          "operations": {
            "items": {
              "$ref": "#/components/schemas/IndexOperation"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Operations"
          }
        },
        "type": "object",
        "required": [
          "operations"
        ],
        "title": "IndexOperationsRequest"
      },
      "IndexRequest": {
        "properties": {
          "apps": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Apps"
          }
        },
        "type": "object",
        "required": [
          "apps"
        ],
        "title": "IndexRequest"
      },
      "LifecycleStatus": {
        "type": "string",
        "enum": [
          "draft",
          "active",
          "deprecated",
          "retired"
        ],
        "title": "LifecycleStatus",
        "description": "Supported application lifecycle states."
      },
      "ReindexRequestV2": {
        "properties": {
          "collection_name": {
            "type": "string",
            "pattern": "^hedge_apps_v2_[a-z0-9_-]{3,40}$",
            "title": "Collection Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "collection_name"
        ],
        "title": "ReindexRequestV2",
        "description": "Administrative request for a versioned, atomically promoted index."
      },
      "SearchFilters": {
        "properties": {
          "semantic_uri": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Semantic Uri"
          },
          "extension_uri": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extension Uri"
          },
          "publisher": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Publisher"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Capabilities"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Tags"
          },
          "protocols": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Protocols"
          },
          "deployment_modes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Deployment Modes"
          },
          "license_spdx": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "License Spdx"
          },
          "lifecycle_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LifecycleStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "supported_languages": {
            "items": {
              "type": "string",
              "enum": [
                "en",
                "de",
                "fr",
                "es",
                "it",
                "nl",
                "pt",
                "tr"
              ]
            },
            "type": "array",
            "title": "Supported Languages"
          },
          "data_classifications": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Data Classifications"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SearchFilters",
        "description": "Typed public catalogue filters."
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          },
          "saref_class": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Saref Class"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequest"
      },
      "SearchRequestV2": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Query"
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "de",
              "fr",
              "es",
              "it",
              "nl",
              "pt",
              "tr"
            ],
            "title": "Locale",
            "default": "en"
          },
          "filters": {
            "$ref": "#/components/schemas/SearchFilters"
          },
          "limit": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 5
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Cursor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequestV2",
        "description": "Versioned search request."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
