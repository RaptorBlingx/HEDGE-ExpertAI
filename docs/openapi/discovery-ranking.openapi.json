              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/apps/{app_id}": {
      "get": {
        "summary": "Get App",
        "description": "Retrieve a single app by ID from the index.",
        "operationId": "get_app_api_v1_apps__app_id__get",
